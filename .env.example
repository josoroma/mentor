# All model traffic stays on this machine. These are loopback endpoints, not public URLs.
LOCAL_AI_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_AI_MODEL=mtplx
LOCAL_SPEECH_URL=http://127.0.0.1:8765
# Read by npm run dev:local; export in the shell for npm run speech:start.
# Underlying speech service/setup default: kokoro, chatterbox, or macos.
# The app requests Kokoro unless the learner saves another engine in Settings.
MENTOR_TTS_PROVIDER=kokoro
# Optional local voice-cloning references; default to setup's synthetic Alex/Sam voices.
# MENTOR_CHATTERBOX_COACH_REFERENCE=/absolute/path/to/coach.wav
# MENTOR_CHATTERBOX_PARTNER_REFERENCE=/absolute/path/to/partner.wav

# npm run db:start writes local Supabase settings to .env.local automatically.
# Leave unset to use only the on-device IndexedDB database. Hosted sync requires opt-in.
# Apply supabase/migrations and supabase/seed.sql; enable anonymous sign-in.
# Only use your project's public anon key. Never put a service-role key here.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
